# rank-worker 独立镜像（多阶段构建，非 root）
#
# Build:
#   docker build -f backend/Dockerfile.rankworker -t feedsystem/rank-worker:latest .
#
ARG GO_VERSION=1.24.5

FROM golang:${GO_VERSION} AS build
WORKDIR /src/backend
ENV GOPROXY=https://goproxy.cn,direct
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags="-s -w" -o /out/rankworker ./cmd/rankworker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata && adduser -D -H -s /sbin/nologin app
WORKDIR /app
COPY --from=build /src/backend/configs ./configs
RUN chown -R app:app /app
USER app
COPY --from=build /out/rankworker /app/rankworker
EXPOSE 8080
ENTRYPOINT ["/app/rankworker"]
